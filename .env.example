# Copy this file to .env and fill in the key. .env is gitignored; this file is
# not, so nothing in here may ever hold a real secret.
#
#   cp .env.example .env
#
# In production these are set as environment variables by the platform, not
# from a file — see render.yaml.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# From https://console.anthropic.com/ — used for both answering and guardrail
# screening. This is the only secret in the project.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional overrides — every one of these has a working default in
# app/config.py. Uncomment only what you actually need to change.
# ---------------------------------------------------------------------------

# ANSWER_MODEL=claude-haiku-4-5-20251001
# GUARD_MODEL=claude-haiku-4-5-20251001

# CHROMA_PATH=chroma_db
# COLLECTION_NAME=kovai_policies

# How many sections retrieval returns before the relevance floor is applied.
# TOP_K=4

# The safety floor, not a tuning knob. Raise it and the bot refuses more;
# lower it and the bot starts answering from sections that are merely the
# least unrelated. Read the comment in app/config.py before touching this.
# MIN_RELEVANCE=0.25

# MAX_ANSWER_TOKENS=500
# MAX_QUESTION_CHARS=500

# RATE_LIMIT=20/minute

# LOG_LEVEL=INFO
# APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Streamlit UI only — read by ui/streamlit_app.py, not by the API. Point it at
# the deployed API to demo against production. On Streamlit Community Cloud
# this goes in the app's secrets instead.
# ---------------------------------------------------------------------------

# API_URL=http://localhost:8000
